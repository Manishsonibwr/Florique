# Copy this to .env and fill in real values. Never commit .env.
NODE_ENV=production
PORT=3000
SESSION_SECRET=paste-a-long-random-string-here
ADMIN_PIN=choose-a-strong-pin
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Optional: where the SQLite database file lives (use your host's persistent disk)
DB_PATH=/var/data/shop.db

# Razorpay webhook (Dashboard -> Settings -> Webhooks). Use the secret you type in there.
RAZORPAY_WEBHOOK_SECRET=choose-a-webhook-secret
